{% extends "base.html.j2" %}
{% block content %}
<h1>{{ title }}</h1>
<p class="meta"><a href="{{ home_href }}">回到首頁</a></p>
{% if not date_links %}
<p>目前還沒有存檔。</p>
{% else %}
<ul class="toc">
{% for d, href, deep_href in date_links %}
<li><a href="{{ href }}">{{ d }}</a>{% if deep_href %} ｜ <a href="{{ deep_href }}">深讀</a>{% endif %}</li>
{% endfor %}
</ul>
{% endif %}

{% if weekly_links %}
<h2>本週主題回顧</h2>
<ul class="toc">
{% for d, href in weekly_links %}
<li><a href="{{ href }}">{{ d }} 那一週</a></li>
{% endfor %}
</ul>
{% endif %}
{% endblock %}
