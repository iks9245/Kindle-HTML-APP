{% extends "base.html.j2" %}
{% block content %}
<h1>{{ title }}</h1>
<p class="meta">
{{ generated_at }}
{% if home_href %}{{ t.sep }}<a href="{{ home_href }}">{{ t.home }}</a>{% endif %}
{% if archive_href %}{{ t.sep }}<a href="{{ archive_href }}">{{ t.archive }}</a>{% endif %}
{% if deepread_href %}{{ t.sep }}<a href="{{ deepread_href }}">{{ t.nav_deepread }}</a>{% endif %}
{% if weekly_href %}{{ t.sep }}<a href="{{ weekly_href }}">{{ t.nav_weekly }}</a>{% endif %}
{% if quiz_href %}{{ t.sep }}<a href="{{ quiz_href }}">{{ t.nav_quiz }}</a>{% endif %}
{% if prev_href %}{{ t.sep }}<a href="{{ prev_href }}">{{ t.prev_day }}</a>{% endif %}
</p>

{% if brief %}
<div class="brief">
<p class="brief-label">{{ t.editor_brief }}</p>
<p>{{ brief }}</p>
</div>
{% endif %}

{% if not categories %}
<p>{{ t.no_articles }}</p>
{% endif %}

{% for category, articles in categories.items() %}
<h2>{{ category }}</h2>
{% for a in articles %}
<article>
  <h3>{{ a.title }}</h3>
  <p class="summary">{{ a.summary }}</p>
  {% if a.summary_secondary %}
  <p class="summary secondary">{{ a.summary_secondary }}</p>
  {% endif %}
  {% if a.qa %}
  <div class="qa">
  {% for pair in a.qa %}
  <details>
    <summary>{{ pair.question }}</summary>
    <p>{{ pair.answer }}</p>
  </details>
  {% endfor %}
  </div>
  {% endif %}
  <p class="source">{{ a.source }}{% if a.slug %}{{ t.sep }}<a href="{{ article_prefix }}{{ a.slug }}{{ article_suffix }}.html">{% if a.read_minutes %}{{ t.full_text_minutes.format(minutes=a.read_minutes) }}{% else %}{{ t.full_text }}{% endif %}</a>{% endif %}{{ t.sep }}<a href="{{ a.link }}">{{ t.original }}</a></p>
</article>
{% endfor %}
{% endfor %}
{% endblock %}
