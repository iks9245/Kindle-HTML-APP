{% extends "base.html.j2" %}
{% block content %}
<h1>{{ title }}</h1>
<p class="meta">
{% if date_str %}{{ date_str }}{{ t.sep }}{% endif %}{% if article_title %}{{ t.deep_this }}{{ article_title }}{% endif %}
{% if home_href %}{{ t.sep }}<a href="{{ home_href }}">{{ t.home }}</a>{% endif %}
{% if digest_href %}{{ t.sep }}<a href="{{ digest_href }}">{{ t.deep_digest }}</a>{% endif %}
{% if archive_href %}{{ t.sep }}<a href="{{ archive_href }}">{{ t.archive }}</a>{% endif %}
{% if article_href %}{{ t.sep }}<a href="{{ article_href }}">{{ t.deep_read_full }}</a>{% endif %}
{% if original_link %}{{ t.sep }}<a href="{{ original_link }}">{{ t.original }}</a>{% endif %}
</p>

{% if not deep %}
<p>{{ t.deep_empty }}</p>
{% else %}
{% if deep.background %}
<h2>{{ t.deep_background }}</h2>
<p>{{ deep.background }}</p>
{% endif %}
{% if deep.points %}
<h2>{{ t.deep_points }}</h2>
<ul>
{% for p in deep.points %}<li>{{ p }}</li>{% endfor %}
</ul>
{% endif %}
{% if deep.implications %}
<h2>{{ t.deep_implications }}</h2>
<p>{{ deep.implications }}</p>
{% endif %}
{% if deep.glossary %}
<h2>{{ t.deep_glossary }}</h2>
<dl class="glossary">
{% for g in deep.glossary %}
<dt>{{ g.term }}</dt>
<dd>{{ g.definition }}</dd>
{% endfor %}
</dl>
{% endif %}
{% endif %}
{% endblock %}
