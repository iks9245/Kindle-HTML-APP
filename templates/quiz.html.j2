{% extends "base.html.j2" %}
{% block content %}
<h1>{{ title }}</h1>
<p class="meta">
{% if source_date %}{{ t.quiz_from.format(date=source_date) }}{% endif %}
{% if home_href %}{{ t.sep }}<a href="{{ home_href }}">{{ t.home }}</a>{% endif %}
{% if archive_href %}{{ t.sep }}<a href="{{ archive_href }}">{{ t.archive }}</a>{% endif %}
</p>

{% if not quiz %}
<p>{{ t.quiz_empty }}</p>
{% else %}
<p class="quizhint">{{ t.quiz_hint }}</p>
<div class="qa">
{% for pair in quiz %}
<details>
  <summary>{{ loop.index }}. {{ pair.question }}</summary>
  <p>{{ pair.answer }}</p>
</details>
{% endfor %}
</div>
{% endif %}
{% endblock %}
