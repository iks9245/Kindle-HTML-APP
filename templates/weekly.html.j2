{% extends "base.html.j2" %}
{% block content %}
<h1>{{ title }}</h1>
<p class="meta">
{% if date_label %}{{ date_label }}{% endif %}
{% if home_href %}{{ t.sep }}<a href="{{ home_href }}">{{ t.home }}</a>{% endif %}
{% if archive_href %}{{ t.sep }}<a href="{{ archive_href }}">{{ t.archive }}</a>{% endif %}
</p>

{% if not roundup %}
<p>{{ t.weekly_empty }}</p>
{% else %}
{% if roundup.intro %}<p class="summary">{{ roundup.intro }}</p>{% endif %}
{% for theme in roundup.themes %}
<h2>{{ theme.title }}</h2>
{% for para in theme.body.split('\n') if para.strip() %}
<p>{{ para.strip() }}</p>
{% endfor %}
{% endfor %}
{% endif %}
{% endblock %}
