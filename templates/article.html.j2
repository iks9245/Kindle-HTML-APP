{% extends "base.html.j2" %}
{% block content %}
{% macro pager() %}
{% if page_total and page_total > 1 %}
<nav class="pager">
{% if prev_href %}<a class="pager-prev" href="{{ prev_href }}">{{ t.prev_page }}</a>{% else %}<span class="pager-prev pager-off">{{ t.prev_page }}</span>{% endif %}
{% if next_href %}<a class="pager-next" href="{{ next_href }}">{{ t.next_page }}</a>{% else %}<span class="pager-next pager-off">{{ t.next_page }}</span>{% endif %}
<span class="pager-num">{{ t.page_of.format(page=page_no, total=page_total) }}</span>
</nav>
{% endif %}
{% endmacro %}
<h1>{{ title }}</h1>
<p class="meta">
{{ source }}{% if read_minutes %}{{ t.sep }}{{ t.read_minutes.format(minutes=read_minutes) }}{% endif %}
{% if page_total and page_total > 1 %}{{ t.sep }}{{ t.page_of.format(page=page_no, total=page_total) }}{% endif %}
{% if home_href %}{{ t.sep }}<a href="{{ home_href }}">{{ t.home }}</a>{% endif %}
{% if archive_href %}{{ t.sep }}<a href="{{ archive_href }}">{{ t.archive }}</a>{% endif %}
{% if original_link %}{{ t.sep }}<a href="{{ original_link }}">{{ t.original }}</a>{% endif %}
</p>

{{ pager() }}

{% if not paragraphs %}
<p>{{ t.no_full_text }}</p>
{% endif %}
{% for para in paragraphs %}
<p class="fulltext">{{ para }}</p>
{% endfor %}

{% if qa %}
<h2>{{ t.follow_up }}</h2>
<div class="qa">
{% for pair in qa %}
<details>
  <summary>{{ pair.question }}</summary>
  <p>{{ pair.answer }}</p>
</details>
{% endfor %}
</div>
{% endif %}

{{ pager() }}
{% endblock %}
